# ---------------------------------------------------------------------------
# Copie para `.env` e ajuste. O docker-compose lê este arquivo automaticamente.
# No EasyPanel, este arquivo é lido pelo editor de Environment do serviço.
#
# NUNCA faça commit de um `.env` com senha real (já está no .gitignore).
# ---------------------------------------------------------------------------

# --- Autenticação (HTTP Basic) -------------------------------
DVR_USER=admin
DVR_PASSWORD=troque-esta-senha

# --- Fuso horário --------------------------------------------
TZ=America/Sao_Paulo

# --- Modo de operação ----------------------------------------
# Qual fonte de vídeo usar (uma câmera por vez):
#   usb    = webcam USB em /dev/video0 (comportamento original)
#   icsee  = câmera IP iCSee/Xmeye via RTSP (porta NET 34567 ou 554)
#   yoosee = câmera IP Yoosee via RTSP (porta 554, fluxos onvif1/onvif2)
DVR_MODO_OP=icsee

# --- Câmera IP (preencha SÓ se DVR_MODO_OP=icsee ou yoosee) ---
# IP da câmera (aceita também "ip:porta" ou "rtsp://ip:porta").
DVR_IPCAM_HOST=10.0.0.74
# Porta RTSP. Padrão automático por modo: icsee=34567 (a "porta NET", preferida;
# troque para 554 se o seu firmware não servir RTSP nela), yoosee=554.
DVR_IPCAM_PORT=34567
# Credenciais da câmera (as mesmas do app iCSee/título do DVR).
DVR_IPCAM_USER=jnkh
DVR_IPCAM_PASS=de4y5w
# Canal (NVR/1ª câmera) e fluxo: 0=principal, 1=secundário (menor resolução).
DVR_IPCAM_CHANNEL=1
DVR_IPCAM_STREAM=0
# tcp = estável em Wi-Fi/PLC (recomendado); udp = menos latência, pode falhar.
DVR_IPCAM_TRANSPORT=tcp
# auto (padrão): copia o H.264 da câmera sem re-encode; re-encode SÓ se houver
#   preset de filtro configurado — que então vale também para a gravação.
# 1: re-encode sempre (pesado no Celeron N3350).
# 0: nunca re-encode (presets de filtro ficam SEM efeito no vídeo).
DVR_IPCAM_TRANSCODE=auto
# URL RTSP completa, sobrescreve TUDO acima (firmwares exóticos). Exemplos:
#   icsee: rtsp://admin:senha@192.168.1.15:34567/user=admin&password=senha&channel=1&stream=0.sdp?real_stream
#   yoosee: rtsp://admin:senha@192.168.1.15:554/onvif1
# DVR_IPCAM_URL=

# --- Câmera USB (preencha SÓ se DVR_MODO_OP=usb) -------------
# Formato de captura v4l2. Vazio = o FFmpeg negocia sozinho.
# Use `mjpeg` se a imagem sair preta/corrompida na maioria das webcams USB.
DVR_INPUT_FORMAT=

# --- Qualidade de imagem/gravação ----------------------------
DVR_VIDEO_SIZE=640x480
DVR_VIDEO_BITRATE=1200k
DVR_FRAMERATE=15
# Vazio = melhor compressão (ao vivo ~1s mais lento). `zerolatency` = menor latência.
DVR_X264_TUNE=zerolatency

# --- Filtros de imagem / controles da câmera -----------------
# Presets: none | night | ir | bright | sharp | mirror | flip | rotate180
# (também dá para trocar em tempo de execução pelo seletor na página principal)
DVR_IMAGE_PRESET=none
# Cadeia FFmpeg livre, somada ao preset. Ex.: eq=saturation=1.2,unsharp=5:5:1.0
DVR_VIDEO_FILTERS=
# Controles da câmera via v4l2-ctl. Veja o que existe em /api/camera/controls.
# Ex.: brightness=128,contrast=32,white_balance_automatic=1
DVR_V4L2_CTRLS=

# --- Gravação / retenção -------------------------------------
# hls (remux do ao vivo, recomendado) | device (abre /dev/video0 direto)
DVR_RECORD_SOURCE=hls
DVR_SEGMENT_SECONDS=600
DVR_RETENTION_SECONDS=86400

# --- Quick Tunnel --------------------------------------------
# Tempo de vida do túnel em segundos (4 h).
DVR_TUNNEL_TTL=14400
